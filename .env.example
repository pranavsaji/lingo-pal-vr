# Copy to .env and add your key to turn on the AI shopkeeper.
# Without a key the app still works, using its built-in offline conversation.
ANTHROPIC_API_KEY=
# Optional: SHOPKEEPER_MODEL=claude-haiku-5-5
# Optional: AGENT_MODEL=claude-haiku-5-5   (model for the tool-using /api/agent route)
# Optional: voice input on Quest (speech-to-text). Set ONE of these; without them the mic
# works only in desktop Chrome (Web Speech API) and learners use pinch/gaze/fingers instead.
# OPENAI_API_KEY=
# DEEPGRAM_API_KEY=
# STT_MODEL=   (provider model name; defaults: whisper-1 for OpenAI, nova-3 for Deepgram)
