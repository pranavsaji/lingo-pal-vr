<!--
  Lesson panel: shows the word you just pinched, the current mission and your score.
  Poppins is bundled because the default font has no French accents.
-->
<style>
  @font-face {
    font-family: poppins;
    src: url(fonts/Poppins-Regular.ttf);
    font-weight: normal;
  }
  @font-face {
    font-family: poppins;
    src: url(fonts/Poppins-Bold.ttf);
    font-weight: bold;
  }

  .root {
    flex-direction: column;
    width: 560px;
    font-family: poppins;
  }

  .header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 16px;
    padding-bottom: 16px;
    padding-left: 24px;
    padding-right: 24px;
    background-color: #16233b;
  }

  .brand {
    color: #fafaf7;
    font-size: 20px;
    font-weight: bold;
  }

  .score {
    color: #e2b857;
    font-size: 20px;
    font-weight: bold;
  }

  .content {
    flex-direction: column;
    gap: 6px;
    padding-top: 18px;
    padding-bottom: 8px;
    padding-left: 24px;
    padding-right: 24px;
  }

  .eyebrow {
    color: #6b5a00;
    font-size: 15px;
    font-weight: bold;
  }

  .eyebrow:dark {
    color: #e2b857;
  }

  .word {
    color: #1c1d20;
    font-size: 44px;
    font-weight: bold;
  }

  .word:dark {
    color: #fafaf7;
  }

  .english {
    color: #3a3b40;
    font-size: 22px;
  }

  .english:dark {
    color: #c3cad6;
  }

  .tip {
    color: #3a3b40;
    font-size: 18px;
  }

  .tip:dark {
    color: #9fb8cc;
  }

  .quest {
    flex-direction: column;
    gap: 4px;
    margin-left: 24px;
    margin-right: 24px;
    margin-top: 4px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 14px;
    padding-right: 14px;
    border-radius: 14px;
    background-color: #e9e2cf;
  }

  .quest:dark {
    background-color: #232c3b;
  }

  .quest-title {
    color: #8a3a12;
    font-size: 15px;
    font-weight: bold;
  }

  .quest-title:dark {
    color: #d9a962;
  }

  .quest-line {
    color: #1c1d20;
    font-size: 17px;
  }

  .quest-line:dark {
    color: #fafaf7;
  }

  .actions {
    flex-direction: row;
    gap: 12px;
    padding-top: 10px;
    padding-bottom: 22px;
    padding-left: 24px;
    padding-right: 24px;
  }

  .action {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 22px;
    padding-right: 22px;
    border-radius: 18px;
    background-color: #3b4a63;
    cursor: pointer;
  }

  .action:hover {
    background-color: #4a5b78;
  }

  .action-text {
    color: #ffffff;
    font-size: 20px;
    font-weight: bold;
  }

  .xp {
    flex-direction: row;
    align-items: center;
    gap: 10px;
    padding-top: 10px;
    padding-left: 24px;
    padding-right: 24px;
  }

  .xp-track {
    width: 400px;
    height: 12px;
    border-radius: 6px;
    background-color: #3a4558;
  }

  .xp-fill {
    width: 0px;
    height: 12px;
    border-radius: 6px;
    background-color: #e2b857;
  }

  .xp-label {
    color: #3a3b40;
    font-size: 14px;
    font-weight: bold;
  }

  .xp-label:dark {
    color: #e2b857;
  }

  .strips {
    flex-direction: row;
    gap: 10px;
    margin-top: 10px;
    margin-left: 24px;
    margin-right: 24px;
  }

  .pass {
    flex-direction: column;
    justify-content: center;
    gap: 2px;
    width: 206px;
    padding-top: 7px;
    padding-bottom: 7px;
    padding-left: 12px;
    padding-right: 12px;
    border-radius: 14px;
    border-width: 1px;
    border-color: #e2b857;
    background-color: #232c3b;
    cursor: pointer;
  }

  .pass:hover {
    background-color: #2e394b;
  }

  .ready {
    flex-direction: column;
    justify-content: center;
    gap: 2px;
    flex-grow: 1;
    padding-top: 7px;
    padding-bottom: 7px;
    padding-left: 12px;
    padding-right: 12px;
    border-radius: 14px;
    border-width: 1px;
    border-color: #3f8f78;
    background-color: #1f3a3a;
    cursor: pointer;
  }

  .ready:hover {
    background-color: #284848;
  }

  .pass-title {
    color: #e2b857;
    font-size: 14px;
    font-weight: bold;
  }

  .ready-title {
    color: #fafaf7;
    font-size: 14px;
    font-weight: bold;
  }

  .pass-text {
    color: #c3cad6;
    font-size: 12px;
  }

  .tut {
    flex-direction: row;
    align-items: center;
    gap: 14px;
    padding-top: 14px;
    padding-left: 24px;
    padding-right: 24px;
  }

  .tut-badge {
    align-items: center;
    justify-content: center;
    width: 84px;
    height: 84px;
    border-radius: 42px;
    background-color: #16233b;
    border-color: #e2b857;
    border-width: 3px;
  }

  .tut-icon {
    width: 52px;
    height: 52px;
    color: #e2b857;
  }

  .choices {
    flex-direction: row;
    gap: 12px;
    padding-top: 12px;
    padding-left: 24px;
    padding-right: 24px;
  }

  .choice {
    flex-direction: column;
    align-items: center;
    gap: 6px;
    width: 116px;
    padding-top: 14px;
    padding-bottom: 12px;
    border-radius: 18px;
    background-color: #232c3b;
    border-color: #3a4558;
    border-width: 2px;
    cursor: pointer;
  }

  .choice:hover {
    background-color: #2e394b;
    border-color: #e2b857;
  }

  .choice-icon {
    width: 46px;
    height: 46px;
    color: #e2b857;
  }

  .choice-text {
    color: #ffffff;
    font-size: 22px;
    font-weight: bold;
  }
</style>
<Panel class="root">
  <div class="header" id="header">
    <span class="brand">LINGO PAL PARIS</span>
    <span class="score" id="score">0 pts</span>
  </div>
  <div class="xp">
    <div class="xp-track"><div class="xp-fill" id="xp-fill"></div></div>
    <span class="xp-label" id="xp-label">A1.2</span>
  </div>
  <div class="strips">
    <div class="pass" id="passport-button">
      <span class="pass-title" id="passport-title">PASSEPORT 0 / 16</span>
      <span class="pass-text" id="passport-label">Série 1 j · 0 repos</span>
    </div>
    <div class="ready" id="ready-button">
      <span class="ready-title" id="ready-title">PRÊT POUR PARIS 0 %</span>
      <span class="pass-text" id="ready-label">0 / 28 situations · voir le plan</span>
    </div>
  </div>
  <div class="tut" id="tut-row" style="display: none">
    <div class="tut-badge" id="tut-badge">
      <Hand class="tut-icon" id="tut-wave" />
      <Grab class="tut-icon" id="tut-pinch" style="display: none" />
      <Pointer class="tut-icon" id="tut-order" style="display: none" />
      <Coins class="tut-icon" id="tut-pay" style="display: none" />
    </div>
  </div>
  <div class="content">
    <span class="eyebrow" id="eyebrow">BIENVENUE ! WELCOME !</span>
    <span class="word" id="word">Pincez un objet</span>
    <span class="english" id="english">Pinch any object on the counter to hear its French name.</span>
    <span class="tip" id="tip">Tip: point your hand at it, then touch thumb and index finger.</span>
  </div>
  <div class="choices" id="choice-row" style="display: none">
    <div class="choice" id="choose-hands"><Hand class="choice-icon" /><span class="choice-text">Mains</span></div>
    <div class="choice" id="choose-eyes"><Eye class="choice-icon" /><span class="choice-text">Yeux</span></div>
    <div class="choice" id="choose-voice"><Mic class="choice-icon" /><span class="choice-text">Voix</span></div>
    <div class="choice" id="choose-text"><ALargeSmall class="choice-icon" /><span class="choice-text" id="choose-text-label">Texte M</span></div>
  </div>
  <div class="quest" id="quest">
    <span class="quest-title" id="quest-title">LISTE DE COURSES · 0 / 3</span>
    <span class="quest-line" id="quest-0">Café Lune : un café</span>
    <span class="quest-line" id="quest-1">Boulangerie : deux croissants</span>
    <span class="quest-line" id="quest-2">Marché : trois pommes</span>
  </div>
  <div class="actions">
    <div class="action" id="start-button" style="background-color: #e2b857">
      <span class="action-text" id="start-label" style="color: #16233b">Commencer la mission</span>
    </div>
    <div class="action" id="repeat-button">
      <span class="action-text">Répéter</span>
    </div>
  </div>
  <div class="actions" id="menu-row">
    <div class="action" id="carnet-button">
      <span class="action-text">Mon Carnet</span>
    </div>
    <div class="action" id="settings-button">
      <span class="action-text">Réglages</span>
    </div>
    <div class="action" id="map-button">
      <span class="action-text" id="map-label">Paris</span>
    </div>
  </div>
  <div class="actions" id="xr-row">
    <div class="action" id="xr-button" style="padding-left: 14px; padding-right: 14px">
      <span class="action-text" id="xr-label">Paris (VR)</span>
    </div>
    <div class="action" id="ar-button" style="padding-left: 14px; padding-right: 14px">
      <span class="action-text" id="ar-label">Ma pièce (MR)</span>
    </div>
    <div class="action" id="exit-button" style="display: none">
      <span class="action-text">Exit VR</span>
    </div>
    <div class="action" id="week-button">
      <span class="action-text">Ma semaine</span>
    </div>
  </div>
</Panel>
