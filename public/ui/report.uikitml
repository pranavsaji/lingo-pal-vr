<!--
  Ma semaine: the weekly progress report. XP per day as bars (today highlighted),
  totals for the week (minutes, new words, orders, pronunciation), and a trend
  versus the week before. Swaps into the lesson panel's slot (src/ui/panels-system.ts).
-->
<style>
  @font-face {
    font-family: poppins;
    src: url(fonts/Poppins-Regular.ttf);
    font-weight: normal;
  }
  @font-face {
    font-family: poppins;
    src: url(fonts/Poppins-Bold.ttf);
    font-weight: bold;
  }

  .root {
    flex-direction: column;
    width: 560px;
    font-family: poppins;
  }

  .header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 14px;
    padding-bottom: 14px;
    padding-left: 22px;
    padding-right: 22px;
    background-color: #e76f51;
  }

  .brand {
    color: #fafaf7;
    font-size: 20px;
    font-weight: bold;
  }

  .sub {
    color: #ffe8df;
    font-size: 15px;
  }

  .chart {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    flex-shrink: 0;
    height: 150px;
    min-height: 150px;
    padding-top: 12px;
    padding-left: 26px;
    padding-right: 26px;
  }

  .col {
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 4px;
    width: 58px;
    height: 150px;
    min-height: 150px;
    flex-shrink: 0;
  }

  .bar {
    flex-shrink: 0;
    width: 34px;
    height: 4px;
    border-radius: 6px;
    background-color: #4a4c55;
  }

  .val {
    color: #3a3b40;
    font-size: 12px;
  }

  .val:dark {
    color: #c9ccd3;
  }

  .day {
    color: #1c1d20;
    font-size: 15px;
    font-weight: bold;
  }

  .day:dark {
    color: #fafaf7;
  }

  .stats {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 12px;
    padding-left: 16px;
    padding-right: 16px;
  }

  .stat {
    flex-direction: column;
    width: 168px;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 12px;
    padding-right: 12px;
    border-radius: 12px;
    background-color: #e9e2cf;
  }

  .stat:dark {
    background-color: #2b2d33;
  }

  .num {
    color: #1c1d20;
    font-size: 24px;
    font-weight: bold;
  }

  .num:dark {
    color: #fafaf7;
  }

  .lbl {
    color: #3a3b40;
    font-size: 12px;
  }

  .lbl:dark {
    color: #b8bcc6;
  }

  .note {
    color: #3a3b40;
    font-size: 15px;
    padding-top: 10px;
    padding-left: 22px;
    padding-right: 22px;
  }

  .note:dark {
    color: #9fd3c7;
  }

  .actions {
    flex-direction: row;
    gap: 12px;
    padding-top: 10px;
    padding-bottom: 18px;
    padding-left: 22px;
    padding-right: 22px;
  }

  .action {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 22px;
    padding-right: 22px;
    border-radius: 18px;
    background-color: #6c757d;
    cursor: pointer;
  }

  .action:hover {
    background-color: #868e96;
  }

  .action-text {
    color: #ffffff;
    font-size: 19px;
    font-weight: bold;
  }
</style>
<Panel class="root">
  <div class="header">
    <span class="brand">MA SEMAINE</span>
    <span class="sub" id="week-range">Your last 7 days</span>
  </div>
  <div class="chart">
    <div class="col"><span class="val" id="bar-0-xp">0</span><div class="bar" id="bar-0"></div><span class="day" id="bar-0-day">L</span></div>
    <div class="col"><span class="val" id="bar-1-xp">0</span><div class="bar" id="bar-1"></div><span class="day" id="bar-1-day">M</span></div>
    <div class="col"><span class="val" id="bar-2-xp">0</span><div class="bar" id="bar-2"></div><span class="day" id="bar-2-day">M</span></div>
    <div class="col"><span class="val" id="bar-3-xp">0</span><div class="bar" id="bar-3"></div><span class="day" id="bar-3-day">J</span></div>
    <div class="col"><span class="val" id="bar-4-xp">0</span><div class="bar" id="bar-4"></div><span class="day" id="bar-4-day">V</span></div>
    <div class="col"><span class="val" id="bar-5-xp">0</span><div class="bar" id="bar-5"></div><span class="day" id="bar-5-day">S</span></div>
    <div class="col"><span class="val" id="bar-6-xp">0</span><div class="bar" id="bar-6"></div><span class="day" id="bar-6-day">D</span></div>
  </div>
  <div class="stats">
    <div class="stat"><span class="num" id="stat-xp">0</span><span class="lbl">XP cette semaine</span></div>
    <div class="stat"><span class="num" id="stat-min">0 min</span><span class="lbl">Temps d'apprentissage</span></div>
    <div class="stat"><span class="num" id="stat-words">0</span><span class="lbl">Nouveaux mots</span></div>
    <div class="stat"><span class="num" id="stat-orders">0</span><span class="lbl">Commandes payées</span></div>
    <div class="stat"><span class="num" id="stat-pron">-</span><span class="lbl">Prononciation moyenne</span></div>
    <div class="stat"><span class="num" id="stat-days">0 / 7</span><span class="lbl">Jours actifs · série</span></div>
  </div>
  <span class="note" id="week-note">Come back tomorrow to start your week.</span>
  <div class="actions">
    <div class="action" id="week-back">
      <span class="action-text">Retour</span>
    </div>
  </div>
</Panel>
