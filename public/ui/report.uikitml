<!--
  Ma semaine: the weekly progress report. XP per day as bars (today highlighted),
  totals for the week (minutes, new words, orders, pronunciation), and a trend
  versus the week before. Swaps into the lesson panel's slot (src/ui/panels-system.ts).
-->
<style>
  @font-face {
    font-family: poppins;
    src: url(fonts/Poppins-Regular.ttf);
    font-weight: normal;
  }
  @font-face {
    font-family: poppins;
    src: url(fonts/Poppins-Bold.ttf);
    font-weight: bold;
  }

  .root {
    flex-direction: column;
    width: 560px;
    font-family: poppins;
  }

  .header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 14px;
    padding-bottom: 14px;
    padding-left: 22px;
    padding-right: 22px;
    background-color: #16233b;
  }

  .brand {
    color: #fafaf7;
    font-size: 20px;
    font-weight: bold;
  }

  .sub {
    color: #c3cad6;
    font-size: 15px;
  }

  .chart {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    flex-shrink: 0;
    height: 150px;
    min-height: 150px;
    padding-top: 12px;
    padding-left: 26px;
    padding-right: 26px;
  }

  .col {
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 4px;
    width: 58px;
    height: 150px;
    min-height: 150px;
    flex-shrink: 0;
  }

  .bar {
    flex-shrink: 0;
    width: 34px;
    height: 4px;
    border-radius: 6px;
    background-color: #3a4558;
  }

  .val {
    color: #3a3b40;
    font-size: 12px;
  }

  .val:dark {
    color: #c3cad6;
  }

  .day {
    color: #1c1d20;
    font-size: 15px;
    font-weight: bold;
  }

  .day:dark {
    color: #fafaf7;
  }

  .stats {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 12px;
    padding-left: 16px;
    padding-right: 16px;
  }

  .stat {
    flex-direction: column;
    width: 168px;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 12px;
    padding-right: 12px;
    border-radius: 12px;
    background-color: #e9e2cf;
  }

  .stat:dark {
    background-color: #232c3b;
  }

  .num {
    color: #1c1d20;
    font-size: 24px;
    font-weight: bold;
  }

  .num:dark {
    color: #fafaf7;
  }

  .lbl {
    color: #3a3b40;
    font-size: 12px;
  }

  .lbl:dark {
    color: #b8bcc6;
  }

  .note {
    color: #3a3b40;
    font-size: 15px;
    padding-top: 10px;
    padding-left: 22px;
    padding-right: 22px;
  }

  .note:dark {
    color: #9fb8cc;
  }

  .goal {
    flex-direction: column;
    gap: 6px;
    margin-top: 10px;
    margin-left: 16px;
    margin-right: 16px;
    padding-top: 10px;
    padding-bottom: 12px;
    padding-left: 14px;
    padding-right: 14px;
    border-radius: 14px;
    background-color: #e9e2cf;
  }

  .goal:dark {
    background-color: #232c3b;
  }

  .goal-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .goal-title {
    color: #8a3a12;
    font-size: 14px;
    font-weight: bold;
  }

  .goal-title:dark {
    color: #d9a962;
  }

  .goal-next {
    color: #3a3b40;
    font-size: 13px;
  }

  .goal-next:dark {
    color: #c3cad6;
  }

  .goal-track {
    width: 496px;
    height: 14px;
    border-radius: 7px;
    background-color: #3a4558;
  }

  .goal-fill {
    width: 7px;
    height: 14px;
    border-radius: 7px;
    background-color: #e2b857;
  }

  .rungs {
    flex-direction: row;
    justify-content: space-between;
  }

  .rung {
    color: #4a5568;
    font-size: 13px;
    font-weight: bold;
  }

  .hook {
    color: #8a3a12;
    font-size: 15px;
    font-weight: bold;
    padding-top: 10px;
    padding-left: 22px;
    padding-right: 22px;
  }

  .hook:dark {
    color: #d9a962;
  }

  .hook-en {
    color: #3a3b40;
    font-size: 13px;
    padding-left: 22px;
    padding-right: 22px;
  }

  .hook-en:dark {
    color: #b8bcc6;
  }

  .actions {
    flex-direction: row;
    gap: 12px;
    padding-top: 10px;
    padding-bottom: 18px;
    padding-left: 22px;
    padding-right: 22px;
  }

  .action {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 22px;
    padding-right: 22px;
    border-radius: 18px;
    background-color: #3b4a63;
    cursor: pointer;
  }

  .action:hover {
    background-color: #4a5b78;
  }

  .action-text {
    color: #ffffff;
    font-size: 19px;
    font-weight: bold;
  }

  .tabs {
    flex-direction: row;
    gap: 8px;
    padding-top: 10px;
    padding-left: 16px;
    padding-right: 16px;
  }

  .tab {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    flex-grow: 1;
    padding-top: 7px;
    padding-bottom: 7px;
    border-radius: 12px;
    background-color: #232c3b;
    border-width: 1px;
    border-color: #3a4558;
    cursor: pointer;
  }

  .tab:hover {
    border-color: #e2b857;
  }

  .tab-text {
    color: #fafaf7;
    font-size: 15px;
    font-weight: bold;
  }

  .view {
    flex-direction: column;
  }

  .pp {
    flex-direction: column;
    gap: 5px;
    padding-top: 12px;
    padding-left: 16px;
    padding-right: 16px;
  }

  .pp-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .pp-title {
    color: #e2b857;
    font-size: 17px;
    font-weight: bold;
  }

  .pp-trip {
    color: #fafaf7;
    font-size: 15px;
    font-weight: bold;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 10px;
    padding-right: 10px;
    border-radius: 10px;
    background-color: #3f8f78;
  }

  .pp-track {
    width: 528px;
    height: 12px;
    border-radius: 6px;
    background-color: #3a4558;
  }

  .pp-fill {
    width: 6px;
    height: 12px;
    border-radius: 6px;
    background-color: #e2b857;
  }

  .prow {
    flex-direction: row;
    align-items: center;
    gap: 6px;
  }

  .pname {
    width: 112px;
    color: #fafaf7;
    font-size: 14px;
    font-weight: bold;
  }

  .chip {
    flex-direction: row;
    justify-content: center;
    width: 98px;
    padding-top: 3px;
    padding-bottom: 3px;
    border-radius: 9px;
    border-width: 1px;
    border-color: #4a5568;
    background-color: #1c2433;
  }

  .chip-text {
    color: #9aa3b2;
    font-size: 12px;
  }

  .plan {
    flex-direction: column;
    gap: 3px;
    margin-top: 8px;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 12px;
    padding-right: 12px;
    border-radius: 12px;
    background-color: #232c3b;
  }

  .plan-title {
    color: #d9a962;
    font-size: 14px;
    font-weight: bold;
  }

  .plan-line {
    color: #fafaf7;
    font-size: 14px;
  }

  .plan-en {
    color: #b8bcc6;
    font-size: 11px;
  }
</style>
<Panel class="root">
  <div class="header">
    <span class="brand">MA SEMAINE</span>
    <span class="sub" id="week-range">Your last 7 days</span>
  </div>
  <div class="tabs">
    <div class="tab" id="tab-week"><span class="tab-text">Ma semaine</span></div>
    <div class="tab" id="tab-paris"><span class="tab-text">Prêt pour Paris</span></div>
  </div>
  <div class="view" id="week-view">
  <div class="chart">
    <div class="col"><span class="val" id="bar-0-xp">0</span><div class="bar" id="bar-0"></div><span class="day" id="bar-0-day">L</span></div>
    <div class="col"><span class="val" id="bar-1-xp">0</span><div class="bar" id="bar-1"></div><span class="day" id="bar-1-day">M</span></div>
    <div class="col"><span class="val" id="bar-2-xp">0</span><div class="bar" id="bar-2"></div><span class="day" id="bar-2-day">M</span></div>
    <div class="col"><span class="val" id="bar-3-xp">0</span><div class="bar" id="bar-3"></div><span class="day" id="bar-3-day">J</span></div>
    <div class="col"><span class="val" id="bar-4-xp">0</span><div class="bar" id="bar-4"></div><span class="day" id="bar-4-day">V</span></div>
    <div class="col"><span class="val" id="bar-5-xp">0</span><div class="bar" id="bar-5"></div><span class="day" id="bar-5-day">S</span></div>
    <div class="col"><span class="val" id="bar-6-xp">0</span><div class="bar" id="bar-6"></div><span class="day" id="bar-6-day">D</span></div>
  </div>
  <div class="stats">
    <div class="stat"><span class="num" id="stat-xp">0</span><span class="lbl">XP cette semaine</span></div>
    <div class="stat"><span class="num" id="stat-min">0 min</span><span class="lbl">Temps d'apprentissage</span></div>
    <div class="stat"><span class="num" id="stat-words">0</span><span class="lbl">Nouveaux mots</span></div>
    <div class="stat"><span class="num" id="stat-orders">0</span><span class="lbl">Commandes payées</span></div>
    <div class="stat"><span class="num" id="stat-pron">-</span><span class="lbl">Prononciation moyenne</span></div>
    <div class="stat"><span class="num" id="stat-days">0 / 7</span><span class="lbl">Jours actifs · série</span></div>
  </div>
  <span class="note" id="week-note">Come back tomorrow to start your week.</span>
  <span class="note" id="week-reallife" style="display: none">Vraie vie : 0 commande sans aide</span>
  <div class="goal">
    <div class="goal-head">
      <span class="goal-title" id="goal-title">OBJECTIF · A1 > A2</span>
      <span class="goal-next" id="goal-next">150 XP to A1.2</span>
    </div>
    <div class="goal-track"><div class="goal-fill" id="goal-fill"></div></div>
    <div class="rungs">
      <span class="rung" id="rung-0">A1.1</span>
      <span class="rung" id="rung-1">A1.2</span>
      <span class="rung" id="rung-2">A1.3</span>
      <span class="rung" id="rung-3">A2.1</span>
      <span class="rung" id="rung-4">A2.2</span>
    </div>
  </div>
  <span class="hook" id="week-hook">Demain : une nouvelle liste.</span>
  <span class="hook-en" id="week-hook-en">Tomorrow: a new list.</span>
  </div>
  <div class="view" id="paris-view" style="display: none">
    <div class="pp">
      <div class="pp-head">
        <span class="pp-title" id="pp-title">PRÊT POUR PARIS 0 %</span>
        <span class="pp-trip" id="pp-trip">J-14</span>
      </div>
      <div class="pp-track"><div class="pp-fill" id="pp-fill"></div></div>
      <span class="plan-en" id="pp-sub">0 / 28 real situations, each checked by the game</span>
      <div class="prow" id="rp-cafe"><span class="pname" id="rp-cafe-name">Café Lune</span><div class="chip" id="rp-cafe-order"><span class="chip-text" id="rp-cafe-order-t">Commander</span></div><div class="chip" id="rp-cafe-speak"><span class="chip-text" id="rp-cafe-speak-t">Le dire</span></div><div class="chip" id="rp-cafe-pay"><span class="chip-text" id="rp-cafe-pay-t">Payer juste</span></div><div class="chip" id="rp-cafe-real"><span class="chip-text" id="rp-cafe-real-t">Sans aide</span></div></div>
      <div class="prow" id="rp-boulangerie"><span class="pname" id="rp-boulangerie-name">Boulangerie</span><div class="chip" id="rp-boulangerie-order"><span class="chip-text" id="rp-boulangerie-order-t">Commander</span></div><div class="chip" id="rp-boulangerie-speak"><span class="chip-text" id="rp-boulangerie-speak-t">Le dire</span></div><div class="chip" id="rp-boulangerie-pay"><span class="chip-text" id="rp-boulangerie-pay-t">Payer juste</span></div><div class="chip" id="rp-boulangerie-real"><span class="chip-text" id="rp-boulangerie-real-t">Sans aide</span></div></div>
      <div class="prow" id="rp-marche"><span class="pname" id="rp-marche-name">Marché</span><div class="chip" id="rp-marche-order"><span class="chip-text" id="rp-marche-order-t">Commander</span></div><div class="chip" id="rp-marche-speak"><span class="chip-text" id="rp-marche-speak-t">Le dire</span></div><div class="chip" id="rp-marche-pay"><span class="chip-text" id="rp-marche-pay-t">Payer juste</span></div><div class="chip" id="rp-marche-real"><span class="chip-text" id="rp-marche-real-t">Sans aide</span></div></div>
      <div class="prow" id="rp-bistrot"><span class="pname" id="rp-bistrot-name">Bistrot</span><div class="chip" id="rp-bistrot-order"><span class="chip-text" id="rp-bistrot-order-t">Commander</span></div><div class="chip" id="rp-bistrot-speak"><span class="chip-text" id="rp-bistrot-speak-t">Le dire</span></div><div class="chip" id="rp-bistrot-pay"><span class="chip-text" id="rp-bistrot-pay-t">Payer juste</span></div><div class="chip" id="rp-bistrot-real"><span class="chip-text" id="rp-bistrot-real-t">Sans aide</span></div></div>
      <div class="prow" id="rp-metro"><span class="pname" id="rp-metro-name">Métro</span><div class="chip" id="rp-metro-order"><span class="chip-text" id="rp-metro-order-t">Commander</span></div><div class="chip" id="rp-metro-speak"><span class="chip-text" id="rp-metro-speak-t">Le dire</span></div><div class="chip" id="rp-metro-pay"><span class="chip-text" id="rp-metro-pay-t">Payer juste</span></div><div class="chip" id="rp-metro-real"><span class="chip-text" id="rp-metro-real-t">Sans aide</span></div></div>
      <div class="prow" id="rp-pharmacie"><span class="pname" id="rp-pharmacie-name">Pharmacie</span><div class="chip" id="rp-pharmacie-order"><span class="chip-text" id="rp-pharmacie-order-t">Commander</span></div><div class="chip" id="rp-pharmacie-speak"><span class="chip-text" id="rp-pharmacie-speak-t">Le dire</span></div><div class="chip" id="rp-pharmacie-pay"><span class="chip-text" id="rp-pharmacie-pay-t">Payer juste</span></div><div class="chip" id="rp-pharmacie-real"><span class="chip-text" id="rp-pharmacie-real-t">Sans aide</span></div></div>
      <div class="prow" id="rp-hotel"><span class="pname" id="rp-hotel-name">Hôtel</span><div class="chip" id="rp-hotel-order"><span class="chip-text" id="rp-hotel-order-t">Commander</span></div><div class="chip" id="rp-hotel-speak"><span class="chip-text" id="rp-hotel-speak-t">Le dire</span></div><div class="chip" id="rp-hotel-pay"><span class="chip-text" id="rp-hotel-pay-t">Payer juste</span></div><div class="chip" id="rp-hotel-real"><span class="chip-text" id="rp-hotel-real-t">Sans aide</span></div></div>
      <div class="plan">
        <span class="plan-title" id="plan-title">AUJOURD'HUI · 10 MIN</span>
        <span class="plan-line" id="plan-0">1. Café Lune : Commander au comptoir</span>
        <span class="plan-en" id="plan-0-en">Café: Order at the counter</span>
        <span class="plan-line" id="plan-1">2.</span>
        <span class="plan-en" id="plan-1-en"></span>
        <span class="plan-line" id="plan-2">3.</span>
        <span class="plan-en" id="plan-2-en"></span>
      </div>
    </div>
  </div>
  <div class="actions">
    <div class="action" id="week-back">
      <span class="action-text">Retour</span>
    </div>
    <div class="action" id="week-passport">
      <span class="action-text">Passeport</span>
    </div>
  </div>
</Panel>
