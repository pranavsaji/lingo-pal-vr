<!--
  Plan de Paris: pick a shop. Each card shows the shop, its shopkeeper and
  whether it is open yet (shops open as the learner progresses). Two cards per
  row; a new shop is one more card with ids place-<id> and place-<id>-status.
  Swaps into the lesson panel's slot (see src/ui/panels-system.ts).
-->
<style>
  @font-face {
    font-family: poppins;
    src: url(fonts/Poppins-Regular.ttf);
    font-weight: normal;
  }
  @font-face {
    font-family: poppins;
    src: url(fonts/Poppins-Bold.ttf);
    font-weight: bold;
  }

  .root {
    flex-direction: column;
    width: 560px;
    font-family: poppins;
  }

  .header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 14px;
    padding-bottom: 14px;
    padding-left: 22px;
    padding-right: 22px;
    background-color: #d1495b;
  }

  .brand {
    color: #fafaf7;
    font-size: 20px;
    font-weight: bold;
  }

  .sub {
    color: #ffe3e8;
    font-size: 15px;
  }

  .list {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 10px;
    padding-top: 14px;
    padding-left: 16px;
    padding-right: 16px;
  }

  .shop {
    flex-direction: column;
    gap: 4px;
    width: 259px;
    flex-shrink: 0;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 14px;
    padding-right: 12px;
    border-radius: 14px;
    background-color: #2b2d33;
    cursor: pointer;
  }

  .shop:hover {
    background-color: #3d5a80;
  }

  .top {
    flex-direction: row;
    align-items: center;
  }

  .name {
    color: #fafaf7;
    font-size: 17px;
    font-weight: bold;
  }

  .who {
    color: #b8bcc6;
    font-size: 12px;
  }

  .status {
    color: #1b1c20;
    font-size: 12px;
    font-weight: bold;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 8px;
    padding-right: 8px;
    border-radius: 10px;
    background-color: #f5d90a;
  }

  .hint {
    color: #3a3b40;
    font-size: 14px;
    padding-top: 10px;
    padding-left: 22px;
    padding-right: 22px;
  }

  .hint:dark {
    color: #9fd3c7;
  }

  .actions {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 10px;
    padding-top: 10px;
    padding-bottom: 18px;
    padding-left: 22px;
    padding-right: 22px;
  }

  .action {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 18px;
    padding-right: 18px;
    border-radius: 18px;
    background-color: #6c757d;
    cursor: pointer;
  }

  .action:hover {
    background-color: #868e96;
  }

  .action-text {
    color: #ffffff;
    font-size: 19px;
    font-weight: bold;
  }
</style>
<Panel class="root">
  <div class="header">
    <span class="brand">PLAN DE PARIS</span>
    <span class="sub">Où allez-vous ?</span>
  </div>
  <div class="list">
    <div class="shop" id="place-cafe">
      <span class="name">Le Café Lune</span>
      <span class="who" id="place-cafe-who">Madame Lune · café, croissants</span>
      <div class="top">
        <span class="status" id="place-cafe-status">Vous êtes ici</span>
      </div>
    </div>
    <div class="shop" id="place-boulangerie">
      <span class="name">La Boulangerie</span>
      <span class="who" id="place-boulangerie-who">Monsieur Paul · pain, gâteaux</span>
      <div class="top">
        <span class="status" id="place-boulangerie-status">Ouvert</span>
      </div>
    </div>
    <div class="shop" id="place-marche">
      <span class="name">Le Marché</span>
      <span class="who" id="place-marche-who">Madame Rose · fruits, légumes</span>
      <div class="top">
        <span class="status" id="place-marche-status">Ouvert</span>
      </div>
    </div>
    <div class="shop" id="place-bistrot">
      <span class="name">Le Bistrot</span>
      <span class="who" id="place-bistrot-who">Monsieur Marcel · déjeuner</span>
      <div class="top">
        <span class="status" id="place-bistrot-status">Bientôt</span>
      </div>
    </div>
    <div class="shop" id="place-metro">
      <span class="name">Le Métro</span>
      <span class="who" id="place-metro-who">Monsieur Karim · tickets</span>
      <div class="top">
        <span class="status" id="place-metro-status">Bientôt</span>
      </div>
    </div>
    <div class="shop" id="place-pharmacie">
      <span class="name">La Pharmacie</span>
      <span class="who" id="place-pharmacie-who">Madame Inès · pansements</span>
      <div class="top">
        <span class="status" id="place-pharmacie-status">Bientôt</span>
      </div>
    </div>
    <div class="shop" id="place-hotel">
      <span class="name">L'Hôtel</span>
      <span class="who" id="place-hotel-who">Madame Claire · réception</span>
      <div class="top">
        <span class="status" id="place-hotel-status">Bientôt</span>
      </div>
    </div>
  </div>
  <span class="hint" id="map-hint">Pinch a shop (or say its name) to go there.</span>
  <div class="actions">
    <div class="action" id="map-back">
      <span class="action-text">Retour</span>
    </div>
    <div class="action" id="map-passport" style="background-color: #6d2e46">
      <span class="action-text" id="map-passport-label">Passeport</span>
    </div>
    <div class="action" id="map-mode" style="background-color: #457b9d">
      <span class="action-text" id="map-mode-label">Ma pièce (MR)</span>
    </div>
    <div class="action" id="map-place" style="display: none; background-color: #2a9d8f">
      <span class="action-text">Placer le café</span>
    </div>
    <div class="action" id="invite-button" style="background-color: #2a9d8f">
      <span class="action-text" id="invite-label">Inviter un ami</span>
    </div>
  </div>
</Panel>
