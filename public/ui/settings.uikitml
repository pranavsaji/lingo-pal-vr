<!--
  Reglages (accessibility settings). Every row is one big pinch/poke/gaze target.
  Also reachable by voice: say "reglages". Swaps into the lesson panel's slot.
-->
<style>
  @font-face {
    font-family: poppins;
    src: url(fonts/Poppins-Regular.ttf);
    font-weight: normal;
  }
  @font-face {
    font-family: poppins;
    src: url(fonts/Poppins-Bold.ttf);
    font-weight: bold;
  }

  .root {
    flex-direction: column;
    width: 560px;
    font-family: poppins;
  }

  .header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 14px;
    padding-bottom: 14px;
    padding-left: 22px;
    padding-right: 22px;
    background-color: #6c4ab6;
  }

  .brand {
    color: #fafaf7;
    font-size: 20px;
    font-weight: bold;
  }

  .sub {
    color: #e6dcff;
    font-size: 14px;
  }

  .rows {
    flex-direction: column;
    gap: 7px;
    padding-top: 12px;
    padding-left: 18px;
    padding-right: 18px;
  }

  .row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 9px;
    padding-bottom: 9px;
    padding-left: 14px;
    padding-right: 14px;
    border-radius: 12px;
    background-color: #2b2d33;
    cursor: pointer;
  }

  .row:hover {
    background-color: #3d5a80;
  }

  .labels {
    flex-direction: column;
  }

  .label {
    color: #fafaf7;
    font-size: 17px;
    font-weight: bold;
  }

  .help {
    color: #b8bcc6;
    font-size: 12px;
  }

  .value {
    color: #1c1d20;
    font-size: 15px;
    font-weight: bold;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 12px;
    padding-right: 12px;
    border-radius: 10px;
    background-color: #c9ccd3;
  }

  .actions {
    flex-direction: row;
    gap: 12px;
    padding-top: 12px;
    padding-bottom: 18px;
    padding-left: 22px;
    padding-right: 22px;
  }

  .action {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 22px;
    padding-right: 22px;
    border-radius: 18px;
    background-color: #6c757d;
    cursor: pointer;
  }

  .action:hover {
    background-color: #8a949c;
  }

  .action-text {
    color: #ffffff;
    font-size: 19px;
    font-weight: bold;
  }

  .summary {
    color: #f5d90a;
    font-size: 14px;
    font-weight: bold;
    padding-top: 10px;
    padding-left: 22px;
    padding-right: 22px;
  }
</style>
<Panel class="root">
  <div class="header">
    <span class="brand">RÉGLAGES</span>
    <span class="sub">Say "réglages" anytime</span>
  </div>
  <span class="summary" id="a11y-summary">Accessibilité : mains · sous-titres · texte M</span>
  <div class="rows">
    <div class="row" id="set-highContrast"><div class="labels"><span class="label">Contraste élevé</span><span class="help">High contrast text and outlines</span></div><span class="value" id="set-highContrast-val">OFF</span></div>
    <div class="row" id="set-textSize"><div class="labels"><span class="label">Taille du texte</span><span class="help">Text size: small, medium, large</span></div><span class="value" id="set-textSize-val">M</span></div>
    <div class="row" id="set-slowSpeech"><div class="labels"><span class="label">Parler lentement</span><span class="help">Madame Lune speaks slower</span></div><span class="value" id="set-slowSpeech-val">OFF</span></div>
    <div class="row" id="set-subtitles"><div class="labels"><span class="label">Sous-titres anglais</span><span class="help">English translation under every line</span></div><span class="value" id="set-subtitles-val">ON</span></div>
    <div class="row" id="set-gazeDwell"><div class="labels"><span class="label">Sélection du regard</span><span class="help">Eyes only: look at a button for 1 second</span></div><span class="value" id="set-gazeDwell-val">OFF</span></div>
    <div class="row" id="set-leftHanded"><div class="labels"><span class="label">Gaucher</span><span class="help">Left-hand mode: coins and mic on the left</span></div><span class="value" id="set-leftHanded-val">OFF</span></div>
    <div class="row" id="set-reduceMotion"><div class="labels"><span class="label">Moins d'animations</span><span class="help">Reduce motion and confetti</span></div><span class="value" id="set-reduceMotion-val">OFF</span></div>
    <div class="row" id="set-mixedReality"><div class="labels"><span class="label">Réalité mixte</span><span class="help">The cafe on your real table (passthrough)</span></div><span class="value" id="set-mixedReality-val">OFF</span></div>
    <div class="row" id="set-voiceFirst"><div class="labels"><span class="label">Mains libres (voix)</span><span class="help">Lune listens after she speaks: no pinch needed</span></div><span class="value" id="set-voiceFirst-val">OFF</span></div>
    <div class="row" id="set-tutorial"><div class="labels"><span class="label">Revoir le tutoriel</span><span class="help">Replay the hand tutorial</span></div><span class="value" id="set-tutorial-val">GO</span></div>
  </div>
  <div class="actions">
    <div class="action" id="settings-back">
      <span class="action-text">Retour</span>
    </div>
  </div>
</Panel>
