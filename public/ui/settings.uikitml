<!--
  Reglages (accessibility settings). Every row is one big pinch/poke/gaze target.
  Also reachable by voice: say "reglages". Swaps into the lesson panel's slot.
-->
<style>
  @font-face {
    font-family: poppins;
    src: url(fonts/Poppins-Regular.ttf);
    font-weight: normal;
  }
  @font-face {
    font-family: poppins;
    src: url(fonts/Poppins-Bold.ttf);
    font-weight: bold;
  }

  .root {
    flex-direction: column;
    width: 560px;
    font-family: poppins;
  }

  .header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 14px;
    padding-bottom: 14px;
    padding-left: 22px;
    padding-right: 22px;
    background-color: #16233b;
  }

  .brand {
    color: #fafaf7;
    font-size: 20px;
    font-weight: bold;
  }

  .sub {
    color: #c3cad6;
    font-size: 14px;
  }

  .rows {
    flex-direction: row;
    gap: 8px;
    padding-top: 10px;
    padding-left: 14px;
    padding-right: 14px;
  }

  .col {
    flex-direction: column;
    gap: 6px;
    width: 262px;
  }

  .row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    gap: 6px;
    padding-top: 7px;
    padding-bottom: 7px;
    padding-left: 10px;
    padding-right: 8px;
    border-radius: 12px;
    background-color: #232c3b;
    cursor: pointer;
  }

  .row:hover {
    background-color: #2e394b;
  }

  .labels {
    flex-direction: column;
    flex-shrink: 1;
  }

  .label {
    color: #fafaf7;
    font-size: 14px;
    font-weight: bold;
  }

  .help {
    color: #b8bcc6;
    font-size: 11px;
  }

  .value {
    flex-shrink: 0;
    color: #fafaf7;
    font-size: 13px;
    font-weight: bold;
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 8px;
    padding-right: 8px;
    border-radius: 10px;
    background-color: #4a5568;
  }

  .actions {
    flex-direction: row;
    gap: 12px;
    padding-top: 10px;
    padding-bottom: 14px;
    padding-left: 22px;
    padding-right: 22px;
  }

  .action {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 22px;
    padding-right: 22px;
    border-radius: 18px;
    background-color: #3b4a63;
    cursor: pointer;
  }

  .action:hover {
    background-color: #4a5b78;
  }

  .action-text {
    color: #ffffff;
    font-size: 19px;
    font-weight: bold;
  }

  .summary {
    color: #e2b857;
    font-size: 14px;
    font-weight: bold;
    padding-top: 10px;
    padding-left: 22px;
    padding-right: 22px;
  }
</style>
<Panel class="root">
  <div class="header">
    <span class="brand">RÉGLAGES</span>
    <span class="sub">Say "réglages" anytime</span>
  </div>
  <span class="summary" id="a11y-summary">Accessibilité : mains · sous-titres · texte M</span>
  <div class="rows">
    <div class="col">
      <div class="row" id="set-highContrast"><div class="labels"><span class="label">Contraste élevé</span><span class="help">High contrast</span></div><span class="value" id="set-highContrast-val">OFF</span></div>
      <div class="row" id="set-textSize"><div class="labels"><span class="label">Taille du texte</span><span class="help">Small, medium, large</span></div><span class="value" id="set-textSize-val">M</span></div>
      <div class="row" id="set-slowSpeech"><div class="labels"><span class="label">Parler lentement</span><span class="help">She speaks slower</span></div><span class="value" id="set-slowSpeech-val">OFF</span></div>
      <div class="row" id="set-subtitles"><div class="labels"><span class="label">Sous-titres anglais</span><span class="help">English under each line</span></div><span class="value" id="set-subtitles-val">ON</span></div>
      <div class="row" id="set-gazeDwell"><div class="labels"><span class="label">Sélection du regard</span><span class="help">Eyes only: look 1 s</span></div><span class="value" id="set-gazeDwell-val">OFF</span></div>
      <div class="row" id="set-leftHanded"><div class="labels"><span class="label">Gaucher</span><span class="help">Coins and mic on the left</span></div><span class="value" id="set-leftHanded-val">OFF</span></div>
      <div class="row" id="set-reduceMotion"><div class="labels"><span class="label">Moins d'animations</span><span class="help">Less motion and confetti</span></div><span class="value" id="set-reduceMotion-val">OFF</span></div>
    </div>
    <div class="col">
      <div class="row" id="set-mixedReality"><div class="labels"><span class="label">Réalité mixte</span><span class="help">The café on your table</span></div><span class="value" id="set-mixedReality-val">OFF</span></div>
      <div class="row" id="set-voiceFirst"><div class="labels"><span class="label">Mains libres (voix)</span><span class="help">She listens, no pinch</span></div><span class="value" id="set-voiceFirst-val">OFF</span></div>
      <div class="row" id="set-realLife"><div class="labels"><span class="label">Vraie vie</span><span class="help">Real Paris: no English</span></div><span class="value" id="set-realLife-val">OFF</span></div>
      <div class="row" id="set-pronunciationHelp"><div class="labels"><span class="label">Aide à la prononciation</span><span class="help">Sounds-like lines</span></div><span class="value" id="set-pronunciationHelp-val">ON</span></div>
      <div class="row" id="set-trip"><div class="labels"><span class="label">Mon voyage à Paris</span><span class="help">Trip countdown: 7, 14, 30 days</span></div><span class="value" id="set-trip-val">AUCUN</span></div>
      <div class="row" id="set-tutorial"><div class="labels"><span class="label">Revoir le tutoriel</span><span class="help">Replay the hand tutorial</span></div><span class="value" id="set-tutorial-val">GO</span></div>
    </div>
  </div>
  <div class="actions">
    <div class="action" id="settings-back">
      <span class="action-text">Retour</span>
    </div>
  </div>
</Panel>
